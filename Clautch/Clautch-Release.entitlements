<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        No iCloud entitlements here — Developer ID signing without a
        provisioning profile cannot include them (Gatekeeper rejects it).
        CloudKitService initializes CKContainer directly and handles
        errors gracefully if CloudKit is unavailable.
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
