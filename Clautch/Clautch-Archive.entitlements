<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Minimal entitlements for the xcodebuild archive step.
        Does NOT include iCloud to avoid provisioning profile requirement.
        The final binary is re-signed with Clautch-Release.entitlements
        which includes iCloud (codesign doesn't check provisioning profiles).
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
